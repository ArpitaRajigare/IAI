
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': ['G'],
    'F': [],
    'G': []
}

def dfs(graph, start, visited=None):
    if visited is None:
        visited = []

    if start not in visited:
        print(start, end=" ")
        visited.append(start)

        for neighbour in graph[start]:
            dfs(graph, neighbour, visited)

print("DFS Traversal:")
dfs(graph, 'A')
