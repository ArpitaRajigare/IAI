
graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2), ('E', 5)],
    'C': [('F', 3)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 4)],
    'G': []
}

h = {
    'A': 6,
    'B': 5,
    'C': 4,
    'D': 3,
    'E': 2,
    'F': 3,
    'G': 0
}

def a_star(graph, start, goal):
    open_list = [(h[start], 0, start)]
    visited = set()
    parent = {}

    while open_list:
        open_list.sort()
        f, g, node = open_list.pop(0)

        if node in visited:
            continue

        print(node, end=" ")
        visited.add(node)

        if node == goal:
            return

        for neighbour, cost in graph[node]:
            if neighbour not in visited:
                new_g = g + cost
                new_f = new_g + h[neighbour]
                parent[neighbour] = node
                open_list.append((new_f, new_g, neighbour))

print("A* Search:")
a_star(graph, 'A', 'G')

